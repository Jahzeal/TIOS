{
  "name": "tios-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w api",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w api",
    "build": "npm run build:backend",
    "start": "npm run start -w api",
    "db:push": "prisma db push --schema=frontend/prisma/schema.prisma"
  },
  "workspaces": [
    "frontend",
    "api"
  ]
}
