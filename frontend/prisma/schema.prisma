datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id             String          @id @default(uuid())
  name           String
  twilioPhone    String          @unique
  forwardPhone   String?
  stripeSecret   String?
  agents         Agent[]
  services       Service[]
  kbEntries      KnowledgeBase[]
  jobs           Job[]
  payments       Payment[]
  reminders      Reminder[]
  smsLogs        SmsLog[]
  calls          Call[]
  appointments   Appointment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Agent {
  id                String        @id @default(uuid())
  name              String
  prompt            String        @db.Text
  voiceId           String
  phoneNumber       String?       @unique
  calendarConnected Boolean       @default(false)
  calendarEmail     String?
  callbackDelayHours Int          @default(24)
  callbackDelayMinutes Int        @default(1440)
  callbackCadence   Json?
  tenantId          String?
  tenant            Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calls             Call[]
  appointments      Appointment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Lead {
  id               String            @id @default(uuid())
  jobId            String?
  job              Job?              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name             String?
  companyName      String?
  website          String?
  phone            String?
  email            String?
  status           String            @default("NEW") // NEW, QUALIFIED, BOOKED, COLD
  interest         String            @default("MEDIUM") // HIGH, MEDIUM, LOW
  notes            String?           @db.Text
  facebook         String?
  instagram        String?
  linkedin         String?
  twitter          String?
  address          String?
  description      String?
  emailStatus      String?           @default("PENDING") // PENDING, GENERATING, COMPLIANCE_APPROVED, COMPLIANCE_REJECTED, SENT, FAILED, SKIPPED_SUPPRESSED, SKIPPED_CAP
  emailSubject     String?
  emailBody        String?
  complianceReason String?
  sentAt           DateTime?
  calls            Call[]
  appointments     Appointment[]
  receivedEmails   ReceivedEmail[]
  meetings         UpcomingMeeting[]
  contacts         Contact[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Contact {
  id          String    @id @default(uuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name        String?
  role        String?
  email       String?
  phone       String?
  linkedin    String?
  emailStatus String?   @default("PENDING")
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ConsentLedger {
  id               String   @id @default(uuid())
  leadId           String
  businessName     String
  email            String
  relevanceReason  String
  checkedAt        DateTime @default(now())
}

model SuppressionList {
  id             String   @id @default(uuid())
  emailOrDomain  String   @unique
  reason         String?
  createdAt      DateTime @default(now())
}

model ReceivedEmail {
  id                  String   @id
  leadId              String
  lead                Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  from                String
  subject             String
  bodyText            String?
  bodyHtml            String?
  receivedAt          DateTime
  draftedReplySubject String?
  draftedReplyBody    String?
  draftedReplyStatus  String   @default("DRAFTED")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model UpcomingMeeting {
  id            String   @id @default(uuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title         String
  email         String
  meetingLink   String
  scheduledAt   DateTime
  googleEventId String?
  status        String?  @default("confirmed")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  username                 String?
  password                 String
  accountType              String                    @default("SALES") // SALES, VOICE, BOTH
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  jobs                     Job[]
  settings                 Settings[]
  googleCalendarConnection GoogleCalendarConnection?
}

model Settings {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  corporateName  String   @default("")
  email          String   @default("onboarding@resend.dev")
  phoneNumber    String   @default("")
  emailTemplate  String   @default("Exclusive Offer: Free Automation Services for {{company}}")
  leadsPerDay    Int      @default(15)
  crawlLocation  String   @default("")
  crawlIndustry  String   @default("")
  crawlKeywords  String   @default("")
  autoRespond    Boolean  @default(true)
  bookingLink    String   @default("https://calendar.app.google/Zg1o5bgrSsUdPgtS8")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GoogleCalendarConnection {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  calendarId   String   @default("primary")
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  connectedAt  DateTime @default(now())
}

model Call {
  id           String      @id @default(uuid())
  sid          String?     @unique // Twilio Call SID
  direction    String      // INBOUND, OUTBOUND
  status       String      // COMPLETED, BUSY, NO_ANSWER, FAILED, IN_PROGRESS
  callerName   String?
  callerPhone  String
  duration     Int         @default(0) // in seconds
  recordingUrl String?
  summary      String?     @db.Text
  sentiment    String?     // POSITIVE, NEUTRAL, NEGATIVE
  transcript   Json?       // Array of dialog turns: { role: string, text: string, timestamp: string }[]
  agentId      String?
  agent        Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  leadId       String?
  lead         Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  tenantId     String?
  tenant       Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
}

model Appointment {
  id            String     @id @default(uuid())
  title         String
  startTime     DateTime
  endTime       DateTime
  googleEventId String?
  leadId        String
  lead          Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId       String
  agent         Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenantId      String?
  tenant        Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reminders     Reminder[]
  createdAt     DateTime   @default(now())
}

model Service {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  requiresDeposit Boolean  @default(false)
  depositAmount   Float    @default(0.0)
  createdAt       DateTime @default(now())
}

model KnowledgeBase {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  question  String   @db.Text
  answer    String   @db.Text
  embedding Json?
  createdAt DateTime @default(now())
}

model Job {
  id          String    @id @default(uuid())
  queueName   String?   @default("OUTBOUND_CALLBACK")
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String?   // "SEARCH" | "URL_LIST"
  query       String?
  location    String?
  keywords    String?
  payload     Json?
  status      String    @default("PENDING") // PENDING, PROCESSING, DONE, COMPLETED, FAILED
  availableAt DateTime? @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  leads       Lead[]
}

model Payment {
  id                  String    @id @default(uuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount              Float
  phone               String
  inquiredService     String?   @default("Utility Service Setup")
  callId              String?
  leadId              String?
  link                String    @db.Text
  stripeSessionId     String?   @unique
  stripePaymentIntent String?
  status              String    @default("PENDING_QUOTE") // PENDING_QUOTE, SMS_SENT, PAID, CANCELLED
  scheduledSmsAt      DateTime?
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime? @updatedAt
}

model Reminder {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  phone         String
  message       String      @db.Text
  scheduledAt   DateTime
  status        String      @default("PENDING") // PENDING, SENT, FAILED
  attempts      Int         @default(0)
  maxAttempts   Int         @default(3)
  error         String?     @db.Text
  createdAt     DateTime    @default(now())
  sentAt        DateTime?
}

model SmsLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone     String
  message   String   @db.Text
  status    String   @default("SENT") // SENT, FAILED
  createdAt DateTime @default(now())
}
